{
  "name": "app-x-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node dist/app.js\"",
    "build": "tsc",
    "start": "node dist/app.js",
    "prisma:prepare": "ts-node prisma/prismaEnv.ts",
    "prisma:generate": "npm run prisma:prepare && prisma generate",
    "prisma:migrate": "npm run prisma:prepare && prisma migrate dev",
    "prisma:deploy": "npm run prisma:prepare && prisma migrate deploy",
    "prisma:db:push": "npm run prisma:prepare && prisma db push",
    "prisma:seed": "npm run prisma:prepare && ts-node prisma/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwong3la/app-x-backend.git"
  },
  "keywords": [],
