PORT=3000
NODE_ENV=development
# Option 1: use a full connection string
DATABASE_URL=

# Option 2: use separate DB values (auto-assembled if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=floymedia
DB_USER=postgres
# Use either DB_PASS or DB_PASSWORD
DB_PASS=postgres
DB_PASSWORD=
DB_SSL=false

JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:3000

# Seed admin (used by `npm run prisma:seed`)
SEED_ADMIN_EMAIL=mwong3la@gmail.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

ADMIN_EMAIL=admin@floymedia.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=FloyMedia Admin

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

# SMTP (optional: only if you implement email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
