generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  New
  Reviewed
  Contacted
  Quoted
  Confirmed
  Assigned
  InProgress
  Editing
  Delivered
  Completed
  Cancelled
}

enum InquiryStatus {
  New
  Reviewed
  Contacted
  Closed
}

enum ApplicationStatus {
  New
  Reviewed
  Shortlisted
  Accepted
  Rejected
}

enum MediaType {
  IMAGE
  VIDEO
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Booking {
  id                  String        @id @default(cuid())
  fullName            String
  phoneNumber         String
  email               String
  serviceRequired     String
  projectType         String?
  projectDate         DateTime?
  projectTime         String?
  location            String?
  duration            String?
  mediaType           String?
  expectedGuests      Int?
  budgetRange         String?
  specialRequirements String?
  message             String?
  status              BookingStatus @default(New)
  adminNotes          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model GalleryCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  items       GalleryItem[]
  videos      VideoHighlight[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GalleryItem {
  id           String           @id @default(cuid())
  title        String
  categoryId   String?
  category     GalleryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description  String?
  fileUrl      String
  thumbnailUrl String?
  mediaType    MediaType
  projectDate  DateTime?
  location     String?
  clientName   String?
  isFeatured   Boolean          @default(false)
  isPublic     Boolean          @default(true)
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model VideoHighlight {
  id           String   @id @default(cuid())
  title        String
  categoryId   String?
  category     GalleryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description  String?
  thumbnailUrl String?
  videoUrl     String
  clientName   String?
  date         DateTime?
  isPublic     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id               String   @id @default(cuid())
  serviceName      String
  shortDescription String?
  fullDescription  String?
  imageUrl         String?
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TeamApplication {
  id             String            @id @default(cuid())
  fullName       String
  phoneNumber    String
  email          String
  location       String?
  skillArea      String
  experienceLevel String?
  portfolioLink  String?
  socialMediaLink String?
  equipmentOwned String?
  availability   String?
  message        String?
  status         ApplicationStatus @default(New)
  createdAt      DateTime          @default(now())
}

model ContactMessage {
  id          String       @id @default(cuid())
  fullName    String
  phoneNumber String?
  email       String
  subject     String
  message     String
  status      InquiryStatus @default(New)
  createdAt   DateTime     @default(now())
}

model Package {
  id          String   @id @default(cuid())
  packageName String
  description String?
  category    String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  projectName String
  clientName  String?
  projectDate DateTime?
  description String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
}
